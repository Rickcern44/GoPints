{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"files": {
		"ignore": ["node_modules", ".svelte-kit", "build", "**/*.svelte"]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	}
}
